<?xml version="1.0"?>
<Container version="2">
  <Name>Hearth</Name>
  <Repository>ghcr.io/anicholas65/hearth:latest</Repository>
  <Registry>https://github.com/anicholas65/hearth/pkgs/container/hearth</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/anicholas65/hearth/issues</Support>
  <Project>https://github.com/anicholas65/hearth</Project>
  <Overview>Self-hosted home manager: recurring maintenance reminders, room-by-room inventory, documents and manuals, contractors, and appliance replacement budgeting. Notifications via Apprise (ntfy, Discord, email, Pushover...).</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/anicholas65/hearth/main/unraid/hearth.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/anicholas65/hearth/main/unraid/icon.png</Icon>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/hearth" Mode="rw" Description="Database and uploaded documents" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/hearth</Config>
  <Config Name="Apprise URLs" Target="APPRISE_URLS" Default="" Mode="" Description="Comma-separated Apprise URLs, e.g. ntfy://ntfy.sh/my-topic" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Username" Target="HEARTH_USERNAME" Default="" Mode="" Description="Optional basic-auth username (set both username and password to enable)" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Password" Target="HEARTH_PASSWORD" Default="" Mode="" Description="Optional basic-auth password" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Reminder lead days" Target="NOTIFY_LEAD_DAYS" Default="3" Mode="" Description="Notify this many days before a task is due" Type="Variable" Display="advanced" Required="false" Mask="false">3</Config>
  <Config Name="Check interval (hours)" Target="NOTIFY_CHECK_HOURS" Default="1" Mode="" Description="How often to check for due tasks (each task notifies at most once per day)" Type="Variable" Display="advanced" Required="false" Mask="false">1</Config>
</Container>
